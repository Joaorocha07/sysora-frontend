# Endereço da API do backend (sysora-backend)
NEXT_PUBLIC_API_URL=http://localhost:3333/api

# (Opcional) Link do botão "Assinar agora" na tela de assinatura:
# WhatsApp de vendas, página de pagamento etc. Ex.: https://wa.me/5511999999999
